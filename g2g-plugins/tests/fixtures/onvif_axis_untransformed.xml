  <tt:VideoAnalytics>
    <tt:Frame UtcTime="2024-03-01T08:15:30.500+02:00">
      <tt:Object ObjectId="7">
        <tt:Appearance>
          <tt:Shape>
            <tt:BoundingBox left="-0.6" top="0.6" right="-0.2" bottom="0.2"/>
            <tt:CenterOfGravity x="-0.4" y="0.4"/>
          </tt:Shape>
          <tt:Class>
            <tt:Type Likelihood="0.55">Human</tt:Type>
          </tt:Class>
        </tt:Appearance>
      </tt:Object>
    </tt:Frame>
  </tt:VideoAnalytics>
</tt:MetadataStream>
